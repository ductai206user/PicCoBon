@using Microsoft.EntityFrameworkCore
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject PickleballClub.Services.ClubSettingsService ClubSettingsService
@inject PickleballClub.Models.PickleballContext SsrDb
@{
    var csrfTokens = Antiforgery.GetAndStoreTokens(Context);
    var ssrSettings = await ClubSettingsService.GetSettingsAsync(SsrDb);
    var ssrVipSurcharge = await SsrDb.TbCourts.AsNoTracking()
        .Where(c => c.IsActive && c.Surcharge > 0)
        .Select(c => c.Surcharge)
        .FirstOrDefaultAsync();
    if (ssrVipSurcharge <= 0) ssrVipSurcharge = 20000;
    var vndFmt = new System.Globalization.NumberFormatInfo { NumberGroupSeparator = "." };
    string ssrStdPriceNum = ssrSettings.BaseCourtPrice.ToString("#,0", vndFmt);
    string ssrPeakTotalNum = (ssrSettings.BaseCourtPrice + ssrSettings.PeakSurchargePerHour).ToString("#,0", vndFmt);
    string ssrVipNum = "+" + ssrVipSurcharge.ToString("#,0", vndFmt);
    string ssrAddress = ssrSettings.RawCms.TryGetValue("address", out var addrVal) && !string.IsNullOrWhiteSpace(addrVal)
        ? addrVal
        : "Khu Thảo Điền, TP. Thủ Đức, TP.HCM";
}
<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="@csrfTokens.RequestToken">
    <title>@(ViewData["Title"] ?? "Spike Pickleball Club — Tổ Hợp Sân Pickleball Trong Nhà & Ngoài Trời")</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23FF5520'/%3E%3Ccircle cx='16' cy='16' r='8' fill='%23D8F826'/%3E%3C/svg%3E">
    <script>
        (function () {
            try {
                var savedTheme = localStorage.getItem('spike_theme');
                if (savedTheme === 'dark' || savedTheme === 'light') {
                    document.documentElement.setAttribute('data-theme', savedTheme);
                    document.documentElement.classList.toggle('dark', savedTheme === 'dark');
                }
            } catch (_) {}
        })();
    </script>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true">
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
</head>
<body>

    <header class="site-header">
        <div class="site-header-inner">
            <a href="/" class="site-brand">
                <div class="site-brand-mark">
                    <iconify-icon icon="mdi:racquetball" width="24"></iconify-icon>
                </div>
                <div class="site-brand-text">
                    <span class="site-brand-name">SPIKE<span>.</span></span>
                    <span class="site-brand-tag">Pickleball Club</span>
                </div>
            </a>

            <nav class="site-nav" id="siteMainNav">
                @await Component.InvokeAsync("MenuTop")
            </nav>

            <div class="site-header-actions">
                <div id="headerAuthActionsMount">
                    @if (Function.IsLogin())
                    {
                        <div class="user-pill">
                            <a href="/Account/Profile" style="display:inline-flex;align-items:center;gap:0.45rem;color:#FFF;text-decoration:none;" title="Hồ sơ cá nhân">
                                <iconify-icon icon="lucide:user-circle" width="18" style="color:var(--color-volt);"></iconify-icon>
                                <span>@Function._FullName</span>
                            </a>
                            <a href="/Account/Logout" class="btn btn-xs btn-ghost" style="color:#FCA5A5;">Thoát</a>
                        </div>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn btn-sm btn-secondary" style="background:rgba(255,255,255,0.1);border-color:rgba(255,255,255,0.2);color:#FFF;">Đăng nhập</a>
                    }
                </div>
                <button type="button"
                        class="sh-site-theme-btn"
                        id="siteThemeToggleBtn"
                        onclick="toggleSpikeTheme()"
                        aria-label="Chuyển đổi giao diện Sáng / Tối"
                        title="Chuyển đổi giao diện Sáng / Tối">
                    <iconify-icon icon="lucide:sun" width="16" class="sh-theme-icon-sun"></iconify-icon>
                    <iconify-icon icon="lucide:moon" width="16" class="sh-theme-icon-moon"></iconify-icon>
                </button>
                @if (Function.IsLogin() && (Function._RoleId == 1 || Function._RoleId == 3))
                {
                    <a href="/Admin" class="btn btn-outline btn-sm btn-pill sh-public-admin-link" style="border-color:rgba(216,248,38,0.45);color:var(--color-volt);background:rgba(216,248,38,0.08);" title="Mở Trung tâm Quản trị">
                        <iconify-icon icon="lucide:layout-dashboard" width="14"></iconify-icon>
                        <span>Quản trị</span>
                    </a>
                }
                <a href="/Booking" class="btn btn-primary btn-sm btn-pill header-cta-book">Đặt sân ngay</a>
                <button type="button" class="mobile-menu-btn" onclick="toggleMobileNav()" aria-label="Mở menu điều hướng">
                    <iconify-icon icon="lucide:menu" width="20"></iconify-icon>
                </button>
            </div>
        </div>
    </header>

    <div id="adminSubbarMount"></div>

    @RenderBody()

    <footer class="site-footer">
        <div class="container">
            <div class="site-footer-grid">
                <div class="site-footer-col">
                    <a href="/" class="site-brand" style="margin-bottom:1rem;">
                        <div class="site-brand-mark">
                            <iconify-icon icon="mdi:racquetball" width="22"></iconify-icon>
                        </div>
                        <div class="site-brand-text">
                            <span class="site-brand-name">SPIKE<span>.</span></span>
                            <span class="site-brand-tag">Pickleball Club</span>
                        </div>
                    </a>
                    <p style="font-size:0.85rem;line-height:1.7;">
                        Tổ hợp sân thi đấu Pickleball trong nhà &amp; ngoài trời với mặt sân Cushion 8 lớp giảm chấn, hệ thống chiếu sáng LED chống chói 1000 Lux và không gian Pro Shop chuyên nghiệp.
                    </p>
                </div>

                <div class="site-footer-col">
                    <h4>Khám phá CLB</h4>
                    <div class="site-footer-links">
                        <a href="/">Trang chủ &amp; Lịch sân trống</a>
                        <a href="/Booking">Đặt sân trực tuyến</a>
                        <a href="/Product">Cửa hàng Pro Shop &amp; Giải khát</a>
                        <a href="/Lookup">Tra cứu mã vé điện tử QR</a>
                    </div>
                </div>

                <div class="site-footer-col">
                    <h4>Bảng giá niêm yết</h4>
                    <div class="site-footer-links">
                        <span>Giờ tiêu chuẩn (<span data-cms="openTime">@ssrSettings.OpenTime</span> – <span data-cms="peakStart">@ssrSettings.PeakStart</span>): <strong style="color:#FFF;" data-cms-price="courtPrice" data-cms="courtPriceFormatted">@ssrStdPriceNum đ/h</strong></span>
                        <span>Khung giờ vàng (<span data-cms="peakStart">@ssrSettings.PeakStart</span> – <span data-cms="closeTime">@ssrSettings.CloseTime</span>): <strong style="color:var(--color-volt);" data-cms-peak-total="true">@ssrPeakTotalNum đ/h</strong></span>
                        <span>Phụ thu sân Indoor VIP: <strong style="color:#FFF;" data-cms="vipSurchargeFormatted">@ssrVipNum đ/h</strong></span>
                        <span>Giờ mở cửa: <strong style="color:#FFF;" data-cms="openHours">@ssrSettings.OpenTime – @ssrSettings.CloseTime</strong></span>
                    </div>
                </div>

                <div class="site-footer-col">
                    <h4>Liên hệ CLB</h4>
                    <div class="site-footer-links">
                        <span style="display:inline-flex;align-items:center;gap:0.45rem;">
                            <iconify-icon icon="lucide:map-pin" width="15" style="color:var(--color-primary);flex-shrink:0;"></iconify-icon>
                            <span data-cms="address">@ssrAddress</span>
                        </span>
                        <span style="display:inline-flex;align-items:center;gap:0.45rem;">
                            <iconify-icon icon="lucide:phone" width="15" style="color:var(--color-primary);flex-shrink:0;"></iconify-icon>
                            <span>Hotline: <strong style="color:var(--color-primary);" data-cms="hotline">@ssrSettings.Hotline</strong></span>
                        </span>
                        <span style="display:inline-flex;align-items:center;gap:0.45rem;">
                            <iconify-icon icon="lucide:mail" width="15" style="color:var(--color-primary);flex-shrink:0;"></iconify-icon>
                            <span>Email: <strong style="color:#E2E8F0;">contact@spikepickleball.vn</strong></span>
                        </span>
                    </div>
                </div>
            </div>

            <div class="site-footer-bottom">
                <span>© 2026 Spike Pickleball Club. Bảo lưu mọi quyền.</span>
                <span>Tổ hợp sân Pickleball mặt Cushion 8 lớp &amp; Đèn LED 1000 Lux</span>
            </div>
        </div>
    </footer>

    @if (Function.IsLogin())
    {
        var roleKey = Function._RoleId == 1 ? "admin" : (Function._RoleId == 3 ? "staff" : "user");
        var roleLabel = Function._RoleId == 1 ? "Ban Quản Trị CLB" : (Function._RoleId == 3 ? "Nhân viên Vận hành" : "Hội viên CLB");
        <script>
            window.SERVER_AUTH_USER = {
                id: @Function._AccountId,
                name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.IsNullOrEmpty(Function._FullName) ? "Hội viên" : Function._FullName)),
                email: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Function._Email)),
                phone: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Function._Phone)),
                skillLevel: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Function._SkillLevel)),
                role: '@roleKey',
                roleLabel: '@Html.Raw(roleLabel)',
                avatar: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Function._Avatar))
            };
            try { localStorage.removeItem('pb_auth_user'); } catch (_) {}
        </script>
    }
    else
    {
        <script>
            window.SERVER_AUTH_USER = null;
            try { localStorage.removeItem('pb_auth_user'); } catch (_) {}
        </script>
    }
    <script src="~/js/shared.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
