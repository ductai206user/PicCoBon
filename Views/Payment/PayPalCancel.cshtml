@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isValidState = ViewBag.IsValidState is bool b && b;
    string stateToken = ViewBag.StateToken as string ?? string.Empty;
    string payPalOrderId = ViewBag.PayPalOrderId as string ?? string.Empty;
    string attemptCode = ViewBag.AttemptCode as string ?? string.Empty;
    string targetType = ViewBag.TargetType as string ?? "booking";
    string targetCode = ViewBag.TargetCode as string ?? string.Empty;
    string payPalEnv = ViewBag.PayPalEnvironment as string ?? "Sandbox";
    bool isSandbox = string.Equals(payPalEnv, "Sandbox", StringComparison.OrdinalIgnoreCase);
}

<main id="mainContent" class="page-main spk-receipt-stage"
      data-pp-mode="cancel"
      data-pp-valid-state="@(isValidState ? "true" : "false")"
      data-pp-state="@stateToken"
      data-pp-order-id="@payPalOrderId"
      data-pp-attempt="@attemptCode"
      data-pp-target-type="@targetType"
      data-pp-target-code="@targetCode"
      data-pp-env="@payPalEnv">

    <div class="spk-receipt-bg-decor" aria-hidden="true">
        <svg class="spk-receipt-court-lines" viewBox="0 0 1440 900" fill="none" preserveAspectRatio="xMidYMid slice">
            <path d="M-80 260C220 90 520 40 900 180C1200 290 1380 210 1540 120" stroke="currentColor" stroke-width="1.5" opacity="0.24" />
            <path d="M-60 720C280 560 580 610 940 760C1220 870 1400 790 1540 690" stroke="currentColor" stroke-width="1.5" opacity="0.20" />
        </svg>
    </div>

    <div id="paypalCheckoutPageRoot"
         data-pp-mode="cancel"
         data-pp-valid-state="@(isValidState ? "true" : "false")"
         data-pp-state="@stateToken"
         data-pp-order-id="@payPalOrderId"
         data-pp-attempt="@attemptCode"
         data-pp-target-type="@targetType"
         data-pp-target-code="@targetCode"
         data-pp-env="@payPalEnv"
         class="spk-receipt-shell">

        <article class="spk-receipt-card is-state-cancelled" id="paypalOutcomeCard" aria-live="polite">
            <div class="spk-receipt-top-row">
                @if (isSandbox)
                {
                    <span class="spk-receipt-env-pill" id="ppEnvBadge">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M10 2v7.31l-4.89 8.43A2 2 0 0 0 6.84 21h10.32a2 2 0 0 0 1.73-3.26L14 9.31V2" />
                            <path d="M8.5 2h7" />
                            <path d="M7 16h10" />
                        </svg>
                        <span>PAYPAL SANDBOX · USD TEST MODE</span>
                    </span>
                }
                <span class="spk-receipt-live-chip" id="ppStatusBadge" style="display:none;">Đã hủy thanh toán</span>
            </div>

            <header class="spk-receipt-hero">
                <div class="spk-receipt-emblem-wrap" id="ppEmblemWrap">
                    <div class="spk-receipt-halo" aria-hidden="true"></div>
                    <div class="spk-receipt-circle" id="ppIconCircle">
                        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="ppMainIcon" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" />
                            <path d="m15 9-6 6" />
                            <path d="m9 9 6 6" />
                        </svg>
                    </div>
                </div>

                <h1 class="spk-receipt-title" id="ppOutcomeTitle">Đang xử lý hủy phiên thanh toán...</h1>
                <p class="spk-receipt-subtitle" id="ppOutcomeSubtitle">
                    Không có khoản tiền nào được ghi nhận trừ trên hệ thống khi hủy phiên PayPal.
                </p>
            </header>

            <section class="spk-receipt-amount-box" id="ppAmountBanner" style="display:none;" aria-label="Giá trị phiên thanh toán">
                <svg class="spk-receipt-amount-waves" viewBox="0 0 720 180" fill="none" preserveAspectRatio="none" aria-hidden="true">
                    <path class="spk-receipt-wave-bottom" d="M0 132C155 82 285 162 455 112C575 76 660 95 720 65V180H0V132Z" />
                    <path class="spk-receipt-wave-top" d="M0 44C140 96 290 18 465 56C595 85 675 40 720 22V0H0V44Z" />
                </svg>
                <div class="spk-receipt-amount-inner">
                    <span class="spk-receipt-amount-label" id="ppAmountLabel">Giá trị phiên đã hủy (VNĐ)</span>
                    <div class="spk-receipt-amount-vnd" id="ppAmountVndDisplay">0đ</div>
                    <div class="spk-receipt-amount-usd-pill" id="ppAmountUsdDisplay">Quy đổi PayPal: ≈ 0.00 USD</div>
                </div>
            </section>

            <section class="spk-receipt-details-card" id="ppMetaSummary" style="display:none;" aria-label="Chi tiết phiên">
                <div class="spk-receipt-details-head">
                    <div class="spk-receipt-details-heading">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:#B45309;" aria-hidden="true">
                            <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z" />
                            <path d="M14 8H8" />
                            <path d="M16 12H8" />
                            <path d="M13 16H8" />
                        </svg>
                        <span>Thông tin phiên thanh toán</span>
                    </div>
                    <span class="spk-receipt-verified-badge" id="ppDetailsStatusBadge">Đã hủy</span>
                </div>
                <div class="spk-receipt-details-grid" id="ppMetaGridHost"></div>
            </section>

            <section id="ppCompletedTicketWrap" class="spk-receipt-ticket-section" style="display:none;" aria-label="Vé điện tử QR">
                <div id="ppCompletedTicketHost"></div>
            </section>

            <footer class="spk-receipt-actions" id="ppActionRow">
                <a href="/Booking" class="spk-receipt-btn-primary">Quay lại Đặt sân</a>
                <a href="/Lookup" class="spk-receipt-btn-secondary">Mở trang Tra cứu</a>
            </footer>
        </article>
    </div>
</main>

<div class="toast-container" id="toastContainer"></div>

@section Scripts {
    <script src="~/js/pages/paypal-checkout.js" asp-append-version="true"></script>
}
