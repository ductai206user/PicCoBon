@model PickleballClub.Models.TbAccount
@{
    Layout = null;
    var authError = TempData["AuthError"] as string;
}
<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đăng Nhập Quản Trị — Spike OS Workspace</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%232E8B57'/%3E%3Ccircle cx='16' cy='16' r='8' fill='%23FFFFFF'/%3E%3C/svg%3E">
    @await Html.PartialAsync("~/Views/Shared/_DesignSystemCss.cshtml")
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
</head>
<body class="sh-auth-body">
    <div class="sh-auth-card">
        <div class="sh-auth-head">
            <div class="sh-auth-logo">
                <iconify-icon icon="mdi:racquetball" width="22"></iconify-icon>
            </div>
            <h1 class="sh-auth-title">Cổng Quản Trị CLB</h1>
            <p class="sh-auth-sub">Đăng nhập hệ thống điều hành Spike Pickleball Club</p>
        </div>

        <form asp-area="Admin" asp-controller="Login" asp-action="Index" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label" for="adminLoginUser">Tài khoản / Email / SĐT</label>
                <input type="text" id="adminLoginUser" asp-for="Username" class="form-input" placeholder="Nhập tên đăng nhập hoặc Email" required>
            </div>
            <div class="form-group">
                <label class="form-label" for="adminLoginPass">Mật khẩu</label>
                <input type="password" id="adminLoginPass" asp-for="Password" class="form-input" placeholder="Nhập mật khẩu" required>
            </div>

            @if (!string.IsNullOrEmpty(authError))
            {
                <div class="sn-alert sn-alert-danger" style="margin-bottom:14px;font-size:0.84rem;">
                    @authError
                </div>
            }

            <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top:8px;">
                <iconify-icon icon="lucide:log-in" width="17"></iconify-icon>
                <span>Đăng nhập Quản trị</span>
            </button>
        </form>

        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:20px;padding-top:14px;border-top:1px solid var(--border-default);font-size:0.82rem;">
            <a href="/Account/Login" style="color:var(--brand-primary-ink);font-weight:600;text-decoration:none;">Trang Đăng nhập chính</a>
            <a href="/" style="color:var(--text-secondary);text-decoration:none;">← Trang chủ</a>
        </div>
    </div>
</body>
</html>
