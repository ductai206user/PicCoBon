@model PickleballClub.Models.TbAccount
@{
    Layout = null;
    var authError = TempData["AuthError"] as string;
}
<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đăng Nhập Quản Trị — Spike Pickleball Admin</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23FF5520'/%3E%3Ccircle cx='16' cy='16' r='8' fill='%23D8F826'/%3E%3C/svg%3E">
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true">
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
    <style>
        body.sh-auth-body {
            min-height: 100vh;
            background: radial-gradient(circle at 20% 20%, rgba(255, 85, 32, 0.14), transparent 45%),
                        radial-gradient(circle at 80% 80%, rgba(216, 248, 38, 0.08), transparent 45%),
                        #090D16;
            color: #F8FAFC;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .sh-auth-card {
            width: 100%;
            max-width: 420px;
            background: #111827;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 14px;
            padding: 2rem 1.85rem;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
        }
        .sh-auth-head {
            text-align: center;
            margin-bottom: 1.5rem;
        }
        .sh-auth-logo {
            width: 46px;
            height: 46px;
            border-radius: 10px;
            background: var(--color-primary, #FF5520);
            color: #FFFFFF;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.75rem;
            box-shadow: 0 8px 20px rgba(255, 85, 32, 0.35);
        }
        .sh-auth-title {
            font-family: var(--font-sans);
            font-size: 1.45rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            color: #F8FAFC;
            line-height: 1.2;
            margin-bottom: 0.25rem;
        }
        .sh-auth-sub {
            font-size: 0.82rem;
            color: #94A3B8;
        }
    </style>
</head>
<body class="sh-auth-body">
    <div class="sh-auth-card">
        <div class="sh-auth-head">
            <div class="sh-auth-logo">
                <iconify-icon icon="mdi:racquetball" width="24"></iconify-icon>
            </div>
            <h1 class="sh-auth-title">Cổng Quản Trị CLB</h1>
            <p class="sh-auth-sub">Đăng nhập hệ thống điều hành Spike Pickleball Club</p>
        </div>

        <form asp-area="Admin" asp-controller="Login" asp-action="Index" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label" style="color:#E2E8F0;">Tài khoản / Email / SĐT</label>
                <input type="text" asp-for="Username" class="form-input" placeholder="Nhập tên đăng nhập hoặc Email" required>
            </div>
            <div class="form-group">
                <label class="form-label" style="color:#E2E8F0;">Mật khẩu</label>
                <input type="password" asp-for="Password" class="form-input" placeholder="Nhập mật khẩu" required>
            </div>

            @if (!string.IsNullOrEmpty(authError))
            {
                <div class="sh-alert-danger" style="padding:0.65rem 0.9rem;margin-bottom:1rem;font-size:0.82rem;">
                    @authError
                </div>
            }

            <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top:0.5rem;">
                <iconify-icon icon="lucide:log-in" width="17"></iconify-icon>
                <span>Đăng nhập Quản trị</span>
            </button>
        </form>

        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1.25rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,0.1);font-size:0.8rem;">
            <a href="/Account/Login" style="color:var(--color-volt);font-weight:600;text-decoration:none;">Trang Đăng nhập chính</a>
            <a href="/" style="color:#94A3B8;text-decoration:none;">← Trang chủ</a>
        </div>
    </div>
</body>
</html>
